NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/mico-leao-dublado
LOG_LEVEL=info
TRUST_PROXY=false

# Deixe vazio para desabilitar a API administrativa de ingestão.
# Em produção, use um segredo aleatório com no mínimo 32 caracteres.
INGEST_API_KEY=

# Trackers públicos adicionais, separados por vírgula ou espaço.
# Execute `npm run trackers:update` para preencher esta variável no arquivo .env.
DEFAULT_TRACKERS=
TRACKER_MAX_SOURCES=30

DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_RETRY_MS=2000
DB_SERVER_SELECTION_TIMEOUT_MS=5000
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=30
